{
  "name": "@donugr/dgradmobbridge",
  "version": "0.1.3",
  "description": "Framework-agnostic Capacitor ads facade with standard ads pass-through and a native ads bridge built on top of @capacitor-community/admob.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "homepage": "https://github.com/donugr/dgradmobbridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donugr/dgradmobbridge.git"
  },
  "bugs": {
    "url": "https://github.com/donugr/dgradmobbridge/issues"
  },
  "author": {
    "name": "donugr"
  },
  "license": "MIT",
  "keywords": [
    "capacitor",
    "capacitor-plugin",
    "plugin",
    "admob",
    "ads",
    "native-ads",
    "ump",
    "consent",
    "google-ump",
    "gdpr"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "^8.0.0",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.json",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "prepare": "npm run clean && npm run build",
    "verify:pack": "npm pack --dry-run",
    "release:check": "npm run build && npm run verify:pack"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "ios/",
    "dist/",
    "CHANGELOG.md",
    "DgrAdmobBridge.podspec",
    "LICENSE",
    "README.md",
    "RELEASING.md",
    "docs/",
    "package.json"
  ]
}
